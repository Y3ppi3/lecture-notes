<?xml version="1.0" encoding="utf-8"?>
<!-- Релиз: только HTTPS, доверие только системным сертификатам (пользовательские CA не принимаются). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
