<?xml version="1.0" encoding="utf-8"?>
<!-- Только debug-сборка: разрешён HTTP к локальному серверу разработки и пользовательские CA (для отладки трафика). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
