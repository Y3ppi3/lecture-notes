{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "production", "API_URL": "https://api.example.com" }
    },
    "production": {
      "env": { "APP_ENV": "production", "API_URL": "https://api.example.com" }
    }
  },
  "submit": { "production": {} }
}
