# Скопируйте в .env и заполните. Файл .env не коммитится.

# ---------- Окружение ----------
# development — локально (SQLite, лимиты в памяти, заглушки нейросетей допустимы)
# production  — сервер; приложение не запустится с небезопасными настройками
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Секреты ----------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------- Развёртывание через docker compose ----------
DOMAIN=api.example.com
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
POSTGRES_USER=lectures
POSTGRES_PASSWORD=
POSTGRES_DB=lectures
REDIS_PASSWORD=
WEB_CONCURRENCY=2

# Для локального запуска без Docker (по умолчанию SQLite-файл dev.db):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/lectures
# REDIS_URL=redis://localhost:6379/0

# ---------- Нейросети сервера ----------
# Используются, когда пользователь не указал свой ключ в приложении.
# Провайдер: id из каталога (app/providers/catalog.py), mock — заглушка для разработки,
# none — ключа сервера нет, пользователи работают только со своими ключами.
#
# Коррекция текста: gigachat | openai | anthropic | gemini | deepseek | openrouter | mistral | groq | custom
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Только для gigachat: GIGACHAT_API_PERS (физлицо) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
LLM_SCOPE=
# Только для custom: адрес OpenAI-совместимого API
LLM_BASE_URL=

# Распознавание речи: salutespeech | openai | groq | custom
STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=
# Только для salutespeech: SALUTE_SPEECH_PERS (физлицо) | SALUTE_SPEECH_CORP | SALUTE_SPEECH_B2B
STT_SCOPE=
STT_BASE_URL=

# Пример для Сбера (ключи авторизации из личного кабинета developers.sber.ru):
# LLM_PROVIDER=gigachat
# LLM_API_KEY=<ключ авторизации GigaChat API>
# LLM_MODEL=GigaChat-2-Pro
# STT_PROVIDER=salutespeech
# STT_API_KEY=<ключ авторизации SaluteSpeech API>

# ---------- Ключи пользователей ----------
# Разрешить пользователям подключать свои ключи нейросетей в приложении
ALLOW_USER_KEYS=true
# Разрешить произвольный адрес OpenAI-совместимого API (провайдер «Другой»)
ALLOW_CUSTOM_BASE_URL=true

# ---------- Лимиты ----------
REGISTRATION_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
LOGIN_ATTEMPTS_PER_MINUTE=10
REGISTRATIONS_PER_HOUR=5
# Суточные квоты действуют только на ключах сервера
DAILY_AUDIO_MB=200
DAILY_CORRECT_CHARS=500000
MAX_AUDIO_MB=25
MAX_TEXT_CHARS=30000
PROVIDER_CONCURRENCY=8
